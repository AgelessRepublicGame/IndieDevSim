  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ExclusiveButtonGroup
  _buttons:
  - {fileID: 33707193}
  - {fileID: 1478858530}
  - {fileID: 2102905807}
  - {fileID: 236698818}
  - {fileID: 909903730}
  - {fileID: 1629882688}
  _badgeSprite: {fileID: -4940782112785720115, guid: d1a92f626c272ab4b97a43ec6052ed05, type: 3}
  _badgeSize: {x: 50, y: 50}
  _badgeOffset: {x: -20, y: -20}
  _buttonDescriptions:
  - 'Red and green bugs move along an unpredictable trajectory (zigzags, sharp turns).
    They stop falling in a straight line. '
  - "The entire screen flips 180\xB0 for 3-5 seconds at a random point in the Programming-Game. "
  - 'Green (false) and white (non-clickable) bugs slowly "creep" over the red bugs.
    If they touch a red bug before the player clicks, the player loses 10% of the
    order''s progress. '
  - " All bug colors are inverted. Red ones become green, green ones become red.
    Purple ones become orange. \r\n"
  - "All office upgrades (coffee machine, whiteboard, coworker) stop working. The
    player relies only on their own skills. The order timer is reduced by 20%. Any
    mistake means the order has failed. \n"
  - 'Bugs appear not sequentially, but simultaneously in different parts of the screen. '
  _descriptionPanel: {fileID: 715107891}
  _descriptionText: {fileID: 1874618529}
  _onSelectionChanged:
    m_PersistentCalls:
      m_Calls: []
